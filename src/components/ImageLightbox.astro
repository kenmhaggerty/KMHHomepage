---
import Icon from './Icon.astro';

/**
 * The viewer for a gallery image, rendered once per page and filled in by
 * src/scripts/imageLightbox.ts when a gallery link is clicked. A <dialog>
 * rather than a plain div because showModal() brings Escape-to-close, a focus
 * trap, and an inert page behind it without any of that being hand-written --
 * and because its ::backdrop is the one thing iOS Safari paints across the
 * whole screen, behind the status bar and the toolbar; see .lightbox in
 * global.css.
 */
---

<dialog class="modal lightbox" data-lightbox aria-label="Image viewer">
  <button type="button" class="modal-close" data-lightbox-close aria-label="Close image viewer">
    <Icon name="xmark" size={18} />
  </button>
  <img class="lightbox-image" data-lightbox-image alt="" />
</dialog>

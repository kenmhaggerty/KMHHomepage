---
interface LinkItem {
  title: string;
  url: string;
}

interface Props {
  title: string;
  links: LinkItem[];
}

const { title, links } = Astro.props;
---

<div class="section">
  <p class="section-title">{title}</p>
  {
    links.map((link) => (
      <a class="link-pill" href={link.url} target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M6.5 9.5L9.5 6.5M7 4L7.94 3.06A2.5 2.5 0 1 1 11.44 6.56L10.5 7.5M9 12L8.06 12.94A2.5 2.5 0 1 1 4.56 9.44L5.5 8.5"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span>{link.title}</span>
      </a>
    ))
  }
</div>

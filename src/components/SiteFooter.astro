---
import ChangelogModal from './ChangelogModal.astro';
import IconLink from './IconLink.astro';
import { siteInfo, version } from '../data/site';
---

<footer class="site-footer">
  <p class="site-external-links">
    {
      siteInfo.footer.links.map((link) => (
        <IconLink url={link.url} icon={link.icon} tooltip={link.tooltip} />
      ))
    }
  </p>
  <p class="site-copyright">{siteInfo.footer.text}</p>
  <p class="site-version">
    {
      /* A button rather than a clickable <p>: this opens something, so it has to
        be reachable by keyboard and announced as a control. Its accessible name
        is the version text itself, with aria-haspopup saying what it opens. */
    }
    <button
      type="button"
      class="version-button"
      data-changelog-open
      aria-haspopup="dialog"
      title="View changelog"
    >
      v{version}
    </button>
  </p>
  <ChangelogModal />
</footer>

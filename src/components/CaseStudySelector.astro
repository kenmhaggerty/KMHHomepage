---
/**
 * The Case Studies heading on the Work page, doubling as a menu of every case
 * study: the title opens a list of them, one row each, and a row is a link to
 * that case study's page. Designed as "Case Studies (Selector)" in Figma.
 *
 * The heading stays a heading. The trigger is a button inside the <h2>, so the
 * page outline still has a Case Studies section and the control is reachable
 * by keyboard, and the list is plain links, so it works as navigation with or
 * without the script that opens and closes it (see scripts/caseStudySelector).
 */
import Icon from './Icon.astro';
import { caseStudies } from '../data/site';
import { displayYear } from '../utils/caseStudies';
import { initCaseStudySelector } from '../scripts/caseStudySelector';

const MENU_ID = 'case-study-selector-menu';

/*
 * The script that opens the list is written into the page right after the
 * list, not left to the site's bundle. That bundle is a module at the end of
 * the document: it is only found once all the HTML has arrived, downloads
 * alongside the fonts and the first images, and runs only after the page has
 * finished parsing -- so on a slow connection the heading sat on screen for
 * seconds before a tap did anything. Inline, it runs the moment the markup
 * above exists, with nothing to download.
 *
 * It is the tested function itself, as the build compiled it, rather than a
 * second copy kept in step by hand. That only works while the function stays
 * self-contained -- reaching for anything outside its own body would be a
 * name the page does not have -- which a test checks by running this exact
 * script in a fresh page.
 */
const inlineInit = `(${initCaseStudySelector.toString()})(document);`;
---

<div class="cs-selector" data-cs-selector>
  <h2 class="section-title">
    {
      /* aria-expanded is the open/closed state, which the CSS also keys the
        chevron's direction off, so the two can never disagree. */
    }
    <button
      type="button"
      class="cs-selector-trigger"
      data-cs-selector-trigger
      aria-expanded="false"
      aria-controls={MENU_ID}
    >
      <span class="cs-selector-label">Case Studies</span>
      <Icon name="chevron-down" size={15} class="cs-selector-chevron" />
    </button>
  </h2>
  <ul id={MENU_ID} class="cs-selector-menu" data-cs-selector-menu hidden>
    {
      caseStudies.map((caseStudy) => (
        <li>
          <a class="cs-selector-row" href={`/work/${caseStudy.key}`}>
            <span class="cs-selector-row-title">{caseStudy.title}</span>
            <span class="cs-selector-row-title" aria-hidden="true">
              •
            </span>
            <span>{caseStudy.company}</span>
            <span>{displayYear(caseStudy.year)}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <script is:inline set:html={inlineInit} />
</div>

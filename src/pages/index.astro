---
import SiteLayout from '../layouts/SiteLayout.astro';
import CaseStudyPanel from '../components/CaseStudyPanel.astro';
import { Image } from 'astro:assets';
import { about, caseStudies, imageAsset } from '../data/site';
import { FILTERS } from '../utils/filters';

/*
 * Panels that are on screen before any scrolling: three across on desktop
 * (the third half-shown), the first row and a half of the mobile grid. Only
 * these load eagerly -- lazy-loading an image the visitor is already looking
 * at just delays it, which is what an audit means by an unoptimized loading
 * attribute.
 */
const EAGER_PANELS = 3;
---

<SiteLayout>
  <div class="page-work">
    <section class="section about">
      <h2 class="section-title">{about.title}</h2>
      <div class="about-content">
        <Image
          class="avatar"
          src={imageAsset(about.avatar)}
          alt={about.avatar_alt}
          width={64}
          height={64}
          {/* The avatar is laid out at 64px but the source is 192px, so ask for
              2x and 3x variants too -- without these Astro resizes it down to a
              flat 64px and it blurs on any Retina screen. */}
          densities={[1, 2, 3]}
          loading="eager"
        />
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>
    <section class="case-studies">
      <div class="cs-header">
        <h2 class="section-title">Case Studies</h2>
        <span class="filter-label">Filter by</span>
        <div class="chips">
          {
            FILTERS.map((filter) => (
              <button type="button" class="chip" data-filter-chip={filter.key} aria-pressed="false">
                {filter.label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="hscroll" data-gallery>
        <div class="hscroll-viewport" data-gallery-scroll>
          {
            caseStudies.map((caseStudy, index) => (
              <CaseStudyPanel caseStudy={caseStudy} eager={index < EAGER_PANELS} />
            ))
          }
        </div>
        <div class="hscroll-track" data-gallery-track="persistent">
          <div class="hscroll-scrubber" data-gallery-scrubber></div>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import CaseStudyPanel from '../components/CaseStudyPanel.astro';
import CaseStudySelector from '../components/CaseStudySelector.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import { Image } from 'astro:assets';
import { about, caseStudies, imageAsset, portraitAsset, siteInfo } from '../data/site';
import { FILTERS } from '../utils/filters';

/*
 * Panels that are on screen before any scrolling: three across on desktop
 * (the third half-shown), the first row and a half of the mobile grid. Only
 * these load eagerly -- lazy-loading an image the visitor is already looking
 * at just delays it, which is what an audit means by an unoptimized loading
 * attribute.
 *
 * The first of them gets the priority hint as well. Loading eagerly only means
 * the fetch is not deferred; it still queues behind the stylesheet and the
 * fonts, which is why the largest paint waited on a picture that was already
 * discoverable in the HTML.
 */
const EAGER_PANELS = 3;

const { portraits } = siteInfo;
---

<SiteLayout>
  <div class="page-work">
    <section class="section about">
      <h2 class="section-title">{about.title}</h2>
      <div class="about-content">
        {
          /* The avatar is laid out at 64px but the source is 192px, so it asks
            for 2x and 3x variants below: without those Astro resizes it down to
            a flat 64px and it blurs on any Retina screen. */
        }
        {
          /* The avatar opens the portraits in the same viewer as the case study
            galleries. It is a real link to the first portrait, so with no
            script it still opens the photo; the rest ride along as hidden
            links in the same data-gallery, which is what the viewer's arrow
            keys step through. With no portraits listed it is a plain photo. */
        }
        <div class="avatar-frame" data-gallery={portraits.length > 0 ? '' : undefined}>
          {
            portraits.length > 0 ? (
              <a
                class="avatar-link"
                href={portraitAsset(portraits[0].full_res).src}
                data-lightbox-open
                data-lightbox-alt={portraits[0].alt_text}
                data-lightbox-caption={portraits[0].html_caption}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Image
                  class="avatar"
                  src={imageAsset(about.avatar)}
                  alt={about.avatar_alt}
                  width={64}
                  height={64}
                  densities={[1, 2, 3]}
                  loading="eager"
                />
              </a>
            ) : (
              <Image
                class="avatar"
                src={imageAsset(about.avatar)}
                alt={about.avatar_alt}
                width={64}
                height={64}
                densities={[1, 2, 3]}
                loading="eager"
              />
            )
          }
          {
            portraits
              .slice(1)
              .map((portrait) => (
                <a
                  hidden
                  href={portraitAsset(portrait.full_res).src}
                  data-lightbox-open
                  data-lightbox-alt={portrait.alt_text}
                  data-lightbox-caption={portrait.html_caption}
                  target="_blank"
                  rel="noopener noreferrer"
                />
              ))
          }
        </div>
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>
    <section class="case-studies">
      <div class="cs-header">
        <CaseStudySelector />
        <div class="filters">
          <span class="filter-label">Filter by</span>
          <div class="chips">
            {
              FILTERS.map((filter) => (
                <button
                  type="button"
                  class="chip"
                  data-filter-chip={filter.key}
                  aria-pressed="false"
                >
                  {filter.label}
                </button>
              ))
            }
          </div>
        </div>
      </div>
      <div class="hscroll" data-gallery>
        <div class="hscroll-viewport" data-gallery-scroll>
          {
            caseStudies.map((caseStudy, index) => (
              <CaseStudyPanel
                caseStudy={caseStudy}
                eager={index < EAGER_PANELS}
                priority={index === 0}
              />
            ))
          }
        </div>
        <div class="hscroll-track" data-gallery-track="persistent">
          <div class="hscroll-scrubber" data-gallery-scrubber></div>
        </div>
      </div>
    </section>
  </div>
  {
    /* The viewer goes in the layout's lightbox slot, at the top of the body: see
      SiteLayout. A Fragment carries the slot attribute because the viewer is
      only there when there are portraits for it to open. */
  }
  <Fragment slot="lightbox">{portraits.length > 0 && <ImageLightbox />}</Fragment>
</SiteLayout>

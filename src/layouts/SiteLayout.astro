---
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
/*
 * The @font-face rules above live in the stylesheet, so the browser only
 * learns the font URLs once it has fetched and parsed the CSS -- by which
 * point it has already painted the text in a fallback face and has to swap,
 * which is the jitter on load. Preloading from the HTML starts these fetches
 * alongside the CSS instead. Only the latin subset is listed: it covers
 * U+0000-00FF, which is every character the site renders.
 */
import publicSans400 from '@fontsource/public-sans/files/public-sans-latin-400-normal.woff2?url';
import publicSans500 from '@fontsource/public-sans/files/public-sans-latin-500-normal.woff2?url';
import publicSans600 from '@fontsource/public-sans/files/public-sans-latin-600-normal.woff2?url';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ViewportToggle from '../components/ViewportToggle.astro';
import DarkModeToggle from '../components/DarkModeToggle.astro';
import { siteInfo } from '../data/site';

interface Props {
  pageTitle?: string;
  description?: string;
  /** Headline on the share card, when it should differ from the page title. */
  shareTitle?: string;
  /** Blurb on the share card, when it should differ from the description. */
  shareDescription?: string;
  /* Opt out of the card hugging its content, for pages whose content is meant
     to fill the window instead (the résumé PDF). */
  fillHeight?: boolean;
}

const { pageTitle, description, shareTitle, shareDescription, fillHeight = false } = Astro.props;
const title = pageTitle ? `${pageTitle} · ${siteInfo.title}` : siteInfo.title;

/*
 * Share cards and canonical links have to be absolute, and a scraper reads the
 * built HTML rather than running in a browser, so these are resolved against
 * the production origin rather than against wherever the page is being served.
 */
const canonicalUrl = new URL(Astro.url.pathname, siteInfo.url).href;
const shareImageUrl = new URL(siteInfo.openGraph.image, siteInfo.url).href;
const cardTitle = shareTitle ?? title;
const cardDescription = shareDescription ?? description ?? siteInfo.description;

/*
 * Google Search results info
 */
const googleTitle = pageTitle ? `${pageTitle} · ${siteInfo.title}` : siteInfo.google.title;
const googleDescription = description ?? siteInfo.google.description;

/*
 * Structured data describing the site itself, so search engines can name
 * it rather than guessing from the page titles. It is the same on every
 * page, and resolved against the same origin as the canonical link so the
 * two never disagree about which host is the real one.
 */
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteInfo.owner.name,
  url: new URL('/', siteInfo.url).href,
};
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: new URL('/', siteInfo.url).href,
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: 'https://www.kenmhaggerty.com/kenmhaggerty-1x1.png',
    width: 1200,
    height: 1200,
  },
};
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteInfo.owner.name,
  url: new URL('/', siteInfo.url).href,
  image: siteInfo.owner.images,
  jobTitle: siteInfo.owner.jobTitle, // optional
  sameAs: siteInfo.owner.links,
};
---

<!doctype html>
<html lang="en" data-viewport="desktop">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Used by Google -->
    <meta name="description" content={googleDescription} />
    <link rel="icon" href={`/${siteInfo.icons.png.large}`} sizes="192x192" type="image/png" />
    <link rel="icon" href={`/${siteInfo.icons.png.small}`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" sizes="180x180" href={`/${siteInfo.icons.appleTouch}`} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteInfo.owner.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={cardTitle} />
    <meta property="og:description" content={cardDescription} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content={String(siteInfo.openGraph.imageWidth)} />
    <meta property="og:image:height" content={String(siteInfo.openGraph.imageHeight)} />
    <meta property="og:image:alt" content={cardTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={cardTitle} />
    <meta name="twitter:description" content={cardDescription} />
    <meta name="twitter:image" content={shareImageUrl} />
    {
      [publicSans400, publicSans500, publicSans600].map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    <!-- Used by Google -->
    <title>{googleTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
    <!-- Panels arrive marked as loading (see CaseStudyPanel). Without script
         nothing would ever clear that, so without script there is no ring. -->
    <noscript>
      <style>
        .skeleton {
          display: none !important;
        }
      </style>
    </noscript>
    <script is:inline>
      /* Set the viewport mode and theme before first paint, to avoid a layout
         flash and a flash of the wrong theme. */
      (() => {
        const read = (key) => {
          try {
            return localStorage.getItem(key);
          } catch {
            /* storage unavailable */
            return null;
          }
        };
        const root = document.documentElement;
        const viewport = read('viewport-mode');
        root.dataset.viewport =
          window.innerWidth < 768 ? 'mobile' : viewport === 'mobile' ? 'mobile' : 'desktop';

        /* Mirrors resolveThemeMode in src/utils/theme.ts. A chosen theme
           holds only while the device's own setting is the one it was chosen
           against; switching the device retires the choice, here and in
           storage, so the site follows the device again. */
        const system = window.matchMedia?.('(prefers-color-scheme: dark)')?.matches
          ? 'dark'
          : 'light';
        const theme = read('theme-mode');
        const chosenAgainst = read('theme-mode-system');
        const chose = theme === 'light' || theme === 'dark';
        if (chose && chosenAgainst !== system) {
          try {
            localStorage.removeItem('theme-mode');
            localStorage.removeItem('theme-mode-system');
          } catch {
            /* storage unavailable */
          }
        }
        root.dataset.theme = chose && chosenAgainst === system ? theme : system;
      })();
    </script>
  </head>
  <body>
    <div class="viewport">
      <div class="toolbar">
        <DarkModeToggle />
        <ViewportToggle />
      </div>
      <script is:inline>
        /* Which toggle looks selected is decided by CSS keyed on the data
           attributes the head script already set, so the buttons paint
           correctly. `aria-pressed` is a DOM attribute, though, so without
           this it would read "false" on both buttons until the module bundle
           finished loading -- assistive tech would announce the wrong state
           for as long as that took. Running here, right after the buttons
           parse, keeps it in step from the first paint. */
        (() => {
          const root = document.documentElement;
          for (const [attribute, active] of [
            ['data-theme-button', root.dataset.theme],
            ['data-mode-button', root.dataset.viewport],
          ]) {
            for (const button of document.querySelectorAll(`[${attribute}]`)) {
              button.setAttribute(
                'aria-pressed',
                String(button.getAttribute(attribute) === active),
              );
            }
          }
        })();
      </script>
      <main class:list={['card', { 'fill-height': fillHeight }]}>
        <SiteHeader />
        <div class="scrollable">
          <slot />
        </div>
      </main>
      <SiteFooter />
    </div>
    <script>
      import { initViewportMode } from '../scripts/viewportMode';
      import { initGalleryScrollbars } from '../scripts/galleryScrollbar';
      import { initCaseStudyFilters } from '../scripts/caseStudyFilters';
      import { initPanelHover } from '../scripts/panelHover';
      import { initThemeMode } from '../scripts/themeMode';
      import { initImageLightbox } from '../scripts/imageLightbox';
      import { initChangelogModal } from '../scripts/changelogModal';
      import { initPanelSkeletons } from '../scripts/panelSkeletons';

      initThemeMode(document, window);
      initViewportMode(document, window);
      initCaseStudyFilters(document);
      initGalleryScrollbars(document, window);
      initPanelHover(document);
      initImageLightbox(document);
      initChangelogModal(document, window);
      initPanelSkeletons(document);
    </script>
  </body>
</html>

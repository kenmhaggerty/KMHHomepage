---
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
/*
 * The @font-face rules above live in the stylesheet, so the browser only
 * learns the font URLs once it has fetched and parsed the CSS -- by which
 * point it has already painted the text in a fallback face and has to swap,
 * which is the jitter on load. Preloading from the HTML starts these fetches
 * alongside the CSS instead. Only the latin subset is listed: it covers
 * U+0000-00FF, which is every character the site renders.
 */
import publicSans400 from '@fontsource/public-sans/files/public-sans-latin-400-normal.woff2?url';
import publicSans500 from '@fontsource/public-sans/files/public-sans-latin-500-normal.woff2?url';
import publicSans600 from '@fontsource/public-sans/files/public-sans-latin-600-normal.woff2?url';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ViewportToggle from '../components/ViewportToggle.astro';
import DarkModeToggle from '../components/DarkModeToggle.astro';
import { siteInfo } from '../data/site';

interface Props {
  pageTitle?: string;
  description?: string;
  /* Opt out of the card hugging its content, for pages whose content is meant
     to fill the window instead (the résumé PDF). */
  fillHeight?: boolean;
}

const { pageTitle, description = 'Portfolio of Ken M. Haggerty', fillHeight = false } = Astro.props;
const title = pageTitle ? `${pageTitle} · ${siteInfo.title}` : siteInfo.title;
---

<!doctype html>
<html lang="en" data-viewport="desktop">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href={`/${siteInfo.favicon}`} />
    {
      [publicSans400, publicSans500, publicSans600].map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    <title>{title}</title>
    <script is:inline>
      /* Set the viewport mode and theme before first paint, to avoid a layout
         flash and a flash of the wrong theme. */
      (() => {
        const read = (key) => {
          try {
            return localStorage.getItem(key);
          } catch {
            /* storage unavailable */
            return null;
          }
        };
        const root = document.documentElement;
        const viewport = read('viewport-mode');
        root.dataset.viewport =
          window.innerWidth < 768 ? 'mobile' : viewport === 'mobile' ? 'mobile' : 'desktop';

        const theme = read('theme-mode');
        root.dataset.theme =
          theme === 'light' || theme === 'dark'
            ? theme
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      })();
    </script>
  </head>
  <body>
    <div class="viewport">
      <div class="toolbar">
        <DarkModeToggle />
        <ViewportToggle />
      </div>
      <main class:list={['card', { 'fill-height': fillHeight }]}>
        <SiteHeader />
        <div class="scrollable">
          <slot />
        </div>
      </main>
      <SiteFooter />
    </div>
    <script>
      import { initViewportMode } from '../scripts/viewportMode';
      import { initGalleryScrollbars } from '../scripts/galleryScrollbar';
      import { initCaseStudyFilters } from '../scripts/caseStudyFilters';
      import { initPanelHover } from '../scripts/panelHover';
      import { initThemeMode } from '../scripts/themeMode';

      initThemeMode(document, window);
      initViewportMode(document, window);
      initCaseStudyFilters(document);
      initGalleryScrollbars(document, window);
      initPanelHover(document);
    </script>
  </body>
</html>
